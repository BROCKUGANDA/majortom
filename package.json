{
  "name": "majortom",
  "version": "0.1.0",
  "description": "Autonomous major-version dependency upgrade agent",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "majortom": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run format:check && npm run typecheck && npm run lint && npx vitest run --exclude \"fixtures/**\"",
    "test:unit": "npx vitest run --exclude \"fixtures/**\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "fixture:test": "npx vitest run --root fixtures/express4",
    "ledger:test": "npx vitest run tests/ledger",
    "scanner:test": "npx vitest run tests/scanner",
    "plan:test": "npx vitest run tests/plan",
    "fixer:test": "npx vitest run tests/fixer",
    "verify:test": "npx vitest run tests/verify",
    "report:test": "npx vitest run tests/report",
    "e2e:test": "npx vitest run tests/e2e",
    "majortom": "node dist/cli/index.js",
    "demo": "npm run build && node dist/demo.js",
    "demo:dry": "npm run build && node dist/demo.js --dry-run",
    "demo:platform": "node scripts/build-platform.mjs"
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "pdf-parse": "1.1.1",
    "ts-morph": "23.0.0",
    "ulid": "2.3.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/express": "4.17.21",
    "@types/node": "20.17.14",
    "@types/pdf-parse": "1.1.4",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "eslint": "9.18.0",
    "express": "4.21.2",
    "globals": "^15.14.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BROCKUGANDA/majortom.git"
  },
  "homepage": "https://github.com/BROCKUGANDA/majortom#readme",
  "bugs": {
    "url": "https://github.com/BROCKUGANDA/majortom/issues"
  },
  "keywords": [
    "dependency-migration",
    "codemod",
    "agent",
    "automation",
    "static-analysis",
    "express",
    "major-version-upgrade",
    "developer-tools"
  ]
}
